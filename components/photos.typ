// ------------------------------------------------------------
// CENTRALIZED PHOTO RENDERING HELPER
// ------------------------------------------------------------
#let report-photo(
  id,
  description: none,
  height: none,
  fit: none,
  ratio: "4:3",
  placeholder: false,
  colors: none,
  fonts: none,
) = {
  let photo = photos.at(id, default: none)

  let final-src = if photo != none { photo.at("src", default: none) } else { none }
  let final-fit = if fit != none { fit } else if photo != none { photo.at("fit", default: "cover") } else { "cover" }
  let final-height = if height != none { height } else if photo != none { photo.at("height", default: 70mm) } else {
    70mm
  }
  let final-desc = if description != none { description } else if photo != none {
    photo.at("description", default: "Project image")
  } else { "Project image" }
  let final-tag = if photo != none { photo.at("tag", default: none) } else { none }

  if placeholder == false and final-src != none {
    block(
      width: 100%,
      height: final-height,
      radius: 3pt,
      clip: true,
      stroke: if colors != none { 0.6pt + colors.line } else { none },
    )[
      #image(final-src, width: 100%, height: 100%, fit: final-fit)
      #if final-tag != none and colors != none and fonts != none [
        #place(top + left, dx: 3.5mm, dy: 3.5mm)[
          #block(
            fill: colors.primary.transparentize(15%),
            radius: 2pt,
            inset: (x: 6pt, y: 3pt),
            stroke: 0.5pt + colors.sand,
          )[
            #text(font: fonts.display, size: 7.5pt, weight: 700, fill: colors.sand, tracking: 0.8pt)[#upper(final-tag)]
          ]
        ]
      ]
    ]
  } else {
    // Elegant institutional placeholder
    block(
      width: 100%,
      height: final-height,
      fill: if colors != none { colors.paper } else { rgb("#F7F7F3") },
      radius: 3pt,
      stroke: (
        left: if colors != none { 3pt + colors.sand } else { 3pt + rgb("#D8B86C") },
        rest: if colors != none { 0.6pt + colors.line } else { 0.6pt + rgb("#D9DEDC") },
      ),
      inset: 6mm,
    )[
      #align(center + horizon)[
        #text(
          font: if fonts != none { fonts.display } else { "Barlow Condensed" },
          size: 15pt,
          weight: 700,
          fill: if colors != none { colors.primary } else { rgb("#114554") },
          tracking: 1.5pt,
        )[
          PHOTO #id
        ]
        #v(2.5mm)
        #text(
          font: if fonts != none { fonts.main } else { "Kantumruy Pro" },
          size: 9pt,
          fill: if colors != none { colors.text } else { rgb("#202627") },
          weight: 500,
        )[
          Suggested: #final-desc
        ]
        #v(2mm)
        #text(
          font: if fonts != none { fonts.display } else { "Barlow Condensed" },
          size: 7.5pt,
          fill: if colors != none { colors.gray } else { rgb("#737B7C") },
          tracking: 1.2pt,
        )[
          RECOMMENDED ASPECT RATIO: #ratio · HIGH RESOLUTION
        ]
      ]
    ]
  }
}
