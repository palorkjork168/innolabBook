  stat-card("១០០ រូប", "គោលដៅសហគ្រិនត្រឹមឆ្នាំ២០២៨"),
  stat-card("៤ រដូវកាល", "វដ្តជីវិតគម្រោងបន្តបន្ទាប់"),
  stat-card("១១០ រូប", "បេក្ខជនរដូវកាលទី២ ដាក់ពាក្យ"),
