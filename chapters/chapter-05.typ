      #text(font: font-khmer-display, size: 7.2pt, weight: "bold", fill: c-white)[ការផ្សព្វផ្សាយលើកទី ២]
    ]
    #v(1.5mm)
    #text(font: font-khmer-display, size: 8.8pt, weight: "bold", fill: c-teal)[សាលាស្រុកស្ទោង]\
    #v(0.8mm)
    #line(length: 100%, stroke: 0.5pt + c-line)
    #v(1.5mm)
    #set par(leading: 6.5pt, justify: true)
    #text(font: font-khmer-body, size: 8.5pt, fill: c-charcoal)[លើកទី២ ៖​ នាថ្ងៃទី៣១ ខែឧសភា នៅសាលាស្រុកស្ទោង ដោយមានការចូលរួមពីលោក អភិបាលស្រុក និងមន្រី្តពាក់ព័ន្ធ។]
  ],
)
#v(3.5mm)


