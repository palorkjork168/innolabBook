// ==============================================================================
// ជំពូកទី៦ ៖ បទពិសោធន៍ និងភាពជោគជ័យរបស់សហគ្រិនទាំង២០រូប
// EDITORIAL CATALOGUE ARCHITECTURE (12 FACING SPREADS · PAGES 67–90)
// ==============================================================================

#label("ch-06")

// ==============================================================================
// SPREAD 1 · PAGE 67 (VERSO / LEFT): CHAPTER OPENER (DEEP TEAL BLOCK)
// ==============================================================================
#page(
  paper: "a4",
  margin: 0pt,
  fill: c-teal,
  header: none,
  footer: none,
)[
  // Running Header Top Left
  #place(top + left, dx: 24mm, dy: 18mm, text(
    font: font-khmer-display,
    size: 7.5pt,
    weight: "bold",
    fill: c-sand,
  )[មន្ទីរពិសោធន៍នវានុវត្តន៍កំពង់ធំ · រដូវកាលទី១])

  // Archival Identification Tag
  #place(top + left, dx: 24mm, dy: 26mm, text(
    font: font-khmer-display,
    size: 6.5pt,
    fill: c-white.transparentize(30%),
  )[ឯកសារផ្លូវការ · កម្រងប្រវត្តិសហគ្រាសជ័យលាភីទាំង ២០])

  // Architectural Geometric Frame behind photo
  #geom-frame(24mm, 36mm, 162mm, 146mm, stroke-color: c-sand, offset-x: -5mm, offset-y: -5mm)

  // Enterprise Scene Photograph
  #place(top + left, dx: 24mm, dy: 36mm, image("../assets/photos/03.jpg", width: 162mm, height: 146mm, fit: "cover"))

  // Enormous Sculptural Numeral 06 overlapping photo bottom edge
  #place(top + left, dx: 18mm, dy: 166mm, display-number("០៦", size: 100pt, fill: c-sand, weight: "regular"))

  // Chapter Identity & Title
  #place(top + left, dx: 24mm, dy: 218mm, stack(
    spacing: 5mm,
    text(font: font-khmer-display, size: 22pt, fill: c-paper)[ជំពូកទី ៦ ៖\ ករណីសិក្សា],
    text(
      font: font-khmer-display,
      size: 9.5pt,
      weight: "bold",
      fill: c-sand-light,
    )[CHAPTER 4: Comprehensive SME Cohort Profiles (The 20 Finalists)],
  ))

  // Figure Caption for Chapter Opener Photo
  #place(top + left, dx: 86mm, dy: 194mm, editorial-caption(
    "សកម្មភាពផលិតកម្ម និងនវានុវត្តន៍របស់សហគ្រាសធុនតូច និងមធ្យមខេត្តកំពង់ធំ",
    meta-tag: "កម្រងប្រវត្តិសហគ្រាស",
    text-color: c-sand-light,
    width: 100mm,
  ))

  // Bottom Datum Line & Folio
  #place(top + left, dx: 24mm, dy: 268mm, line(length: 162mm, stroke: 0.5pt + c-teal.lighten(30%)))
  #place(top + left, dx: 24mm, dy: 274mm, catalogue-folio(
    67,
    header-left: "ជំពូកទី៦ ៖ បទពិសោធន៍ និងភាពជោគជ័យរបស់សហគ្រិនទាំង២០រូប",
    side: "left",
    folio-color: c-sand,
    color: c-sand-light,
  ))
]


// ==============================================================================
// SPREAD 1 · PAGE 68 (RECTO / RIGHT): SECTOR PROFILES & LCDC LOOP (WARM PAPER)
// REFINED 2-COLUMN MINIMALIST SPREAD (ZERO OVERFLOW)
// ==============================================================================
#page(
  paper: "a4",
  margin: 0pt,
  fill: c-paper,
  header: none,
  footer: none,
)[
  // Running Header Top Right
  #place(top + left, dx: 24mm, dy: 18mm, text(
    font: font-khmer-display,
    size: 7.5pt,
    weight: "bold",
    fill: c-charcoal.lighten(30%),
  )[មន្ទីរពិសោធន៍នវានុវត្តន៍កំពង់ធំ · ប្រវត្តិរូបតាមវិស័យ])

  // Title
  #place(top + left, dx: 24mm, dy: 28mm, khmer-display-title(
    "ករណីសិក្សា",
    preset: "lg",
    size: 16pt,
    color: c-teal,
    rule-length: 120mm,
    rule-stroke: 1pt + c-sand,
  ))

  // Balanced 2-Column Minimalist Sector Overview
  #place(top + left, dx: 24mm, dy: 54mm, grid(
    columns: (78mm, 78mm),
    column-gutter: 6mm,

    // Left Column: Sector A (Modernized Agriculture & Circular Supply Chains)
    stack(
      spacing: 3mm,
      block[
        #text(font: font-khmer-display, size: 8.5pt, weight: "bold", fill: c-teal)[4.1 Sector A: Modernized Agriculture & Circular Supply Chains]
        #v(1mm)
        #line(length: 100%, stroke: 0.5pt + c-sand)
      ],
      block[
        #set par(leading: 6.8pt, justify: false)
        #text(font: font-khmer-body, size: 7.2pt, fill: c-charcoal)[
          *4.1.1 Cashew SSKH (Seng Sokheng Cashew)*           #text(fill: c-charcoal.lighten(15%))[- Operational Mandate: To transition Kampong Thom's extensive raw cashew nut production away from low-margin raw exports toward fully processed, packaged, high-value consumer products.]           #text(fill: c-charcoal.lighten(15%))[- Circular Economy Integration: The enterprise developed a specialized process that gathers post-harvest cashew wood and branch waste, transforming it into high-grade dry biochar. This nutrient-rich biochar is reintroduced back into the orchard soil, reducing dependency on imported chemical fertilizers, locking carbon into the ground, and lowering operational input costs. PDF+ 1]           #text(fill: c-charcoal.lighten(15%))[- Scalability Projections: Integrating automated roasting, vacuum-sealing, and moisture-control equipment will allow the business to systematically scale its output to match national retail specifications.]
        ]
      ],
      block[
        #set par(leading: 6.8pt, justify: false)
        #text(font: font-khmer-body, size: 7.2pt, fill: c-charcoal)[
          *4.1.2 Modern Agriculture Community of Sambour Prei Kuk*           #text(fill: c-charcoal.lighten(15%))[- Operational Mandate: A collective designed to aggregate smallholder agricultural yields, ensuring consistent quality, fair pricing, and direct market access.]           #text(fill: c-charcoal.lighten(15%))[- Circular Economy Integration: Deployed localized composting frameworks that collect organic crop residues and processing waste, turning them into high-nutrient fertilizers for the community's farms. This approach eliminates open-air field burning, vastly improving local air quality and maintaining soil health. PDF]
        ]
      ],
      block[
        #set par(leading: 6.8pt, justify: false)
        #text(font: font-khmer-body, size: 7.2pt, fill: c-charcoal)[
          *4.1.3 LCDC Eco Green*           #text(fill: c-charcoal.lighten(15%))[- Operational Mandate: Developing highly resilient, integrated organic farming models that lower chemical dependency and maximize land-use efficiency. PDF]           #text(fill: c-charcoal.lighten(15%))[- Circular Economy Integration: Standardized a highly effective system that pairs organic duck raising directly with seasonal rice cultivation. The ducks provide natural, biological pest control and weed management within the paddy fields, while their waste serves as an immediate, ongoing organic fertilizer. The business also processes specialized liquid organic fertilizers to support surrounding smallholder farms. PDF+ 2]
        ]
      ],
      // Minimalist horizontal LCDC loop
      block(
        fill: c-sand-light.transparentize(50%),
        inset: 2.5mm,
        radius: 2pt,
        stroke: 0.4pt + c-sand,
      )[
        /*
        ┌────────────────────────────────┐
        │      LCDC ECO GREEN LOOP       │
        └────────────────────────────────┘
        │
        ┌─────────────────────┴─────────────────────┐
        ▼                                           ▼
        ┌──────────────────┐                        ┌──────────────────┐
        │   Duck Raising   │ ───(Natural Waste)───> │ Rice Cultivation │
        └──────────────────┘                        └──────────────────┘
        ▲                                           │
        │                                           │
        └───────────(Biological Pest Control)───────┘
        */
        #align(center)[
          #text(font: font-sans, size: 6.5pt, weight: "bold", fill: c-teal)[│      LCDC ECO GREEN LOOP       │]
          #v(1.5mm)
          #grid(
            columns: (1fr, 1fr),
            gutter: 2.5mm,
            block(fill: c-teal, inset: (x: 2mm, y: 1.5mm), radius: 2pt)[
              #text(font: font-sans, size: 6pt, fill: c-white)[│   Duck Raising   │ ───(Natural Waste)───> │ Rice Cultivation │]
            ],
            block(fill: c-sand, inset: (x: 2mm, y: 1.5mm), radius: 2pt)[
              #text(font: font-sans, size: 6pt, fill: c-teal.darken(20%))[│   Rice Cultivation   │ ───(Natural Waste)───> │ Rice Cultivation │]
            ],
          )
        ]
      ]
    ),

    // Right Column: Sector B (Traditional Enterprise Modernization & Handicrafts)
    stack(
      spacing: 3mm,
      block[
        #text(font: font-khmer-display, size: 8.5pt, weight: "bold", fill: c-teal)[4.2 Sector B: Traditional Enterprise Modernization & Handicrafts]
        #v(1mm)
        #line(length: 100%, stroke: 0.5pt + c-sand)
      ],
      block[
        #set par(leading: 6.8pt, justify: false)
        #text(font: font-khmer-body, size: 7.2pt, fill: c-charcoal)[
          *4.2.1 Sreng Hun Soybean Craft*           #text(fill: c-charcoal.lighten(15%))[(Operational Mandate: Preserving and upgrading traditional, local soybean processing techniques to meet modern food-safety, labeling, and shelf-life standards. PDF Modernization Protocols: Swapped out highly inconsistent manual boiling and fermentation methods for temperature-controlled stainless-steel equipment. The business introduced standardized nutritional labeling and vacuum-seal packaging, allowing its products to expand beyond small village markets into urban grocery chains.)]
        ]
      ],
      block[
        #set par(leading: 6.8pt, justify: false)
        #text(font: font-khmer-body, size: 7.2pt, fill: c-charcoal)[
          *4.2.2 Khmer Pantry*           #text(fill: c-charcoal.lighten(15%))[(Operational Mandate: Taking regional wild palm fruit derivatives and traditional ingredients and transforming them into modern, shelf-stable culinary products. PDF Modernization Protocols: Successfully engineered a standardized manufacturing process that turns raw palm fruit pulp into high-value, ready-to-use palm beverage powders, pancake mixes, and organic sweetening syrups. The refined products use clean packaging that preserves freshness without relying on artificial chemical additives. PDF)]
        ]
      ],
    )
  ))

  // Bottom Datum Line & Folio
  #place(top + left, dx: 24mm, dy: 268mm, line(length: 162mm, stroke: 0.5pt + c-line))
  #place(top + left, dx: 24mm, dy: 274mm, catalogue-folio(
    68,
    header-right: "ទិដ្ឋភាពរួមនៃសហគ្រាសតាមវិស័យ",
    side: "right",
  ))
]

// ============================================================
// CASE 01: លោក សុង សេង - សិប្បកម្មផលិតប្រេងសណ្ដែកផ្កាយ
// ============================================================
#case-study-full(
  "01",
  "លោក សុង សេង",
  "សិប្បកម្មផលិតប្រេងសណ្ដែកផ្កាយ",
  photo-id: "19",
  background: [
    #text(font: font-khmer-display, size: 8pt, weight: "bold", fill: c-teal)[១. លោក សុង សេង​ - សិប្បកម្មផលិតប្រេង​សណ្ដែកផ្កាយ]
    #v(1mm)
    #set par(justify: false, leading: 7.5pt)
    សមាគមសួស្តីកម្ពុជា ត្រូវបានបង្កើតឡើងនៅថ្ងៃទី២៤ ខែកក្កដា ឆ្នាំ១៩៩៣ ដោយលោក សុង សេង និងបានចុះបញ្ជីជាផ្លូវការជាមួយក្រសួងមហាផ្ទៃ។ បច្ចុប្បន្ន សមាគមបានប្រែក្លាយទៅជាអង្គភាពពាណិជ្ជកម្មដ៏គួរឱ្យទុកចិត្តមួយ ដែលផ្ដោតសំខាន់លើការចាប់យកអត្ថប្រយោជន៍ផ្នែកសុខភាពពីប្រេងសណ្ដែកផ្កាយ ដែលជាអាហារ ពីតំបន់អាម៉ាហ្សូន សម្បូរទៅដោយអាស៊ីតខ្លាញ់អូមេហ្គា​ (Omega fatty acids) ប្រូតេអ៊ីន និងសារធាតុប្រឆាំងអុកស៊ីតកម្ម​ (antioxidants ) ជូនដល់ប្រជាជនកម្ពុជា។ ដោយប្រទេសកម្ពុជាមានច្បាប់អាជីវកម្មដ៏តឹងរឹង និងមានការទទួលខុសត្រូវខ្ពស់ផ្នែកសង្គម សមាគមបានសហការជាមួយគ្រួសារកសិករប្រមាណ ៤៥ គ្រួសារ នៅក្នុងខេត្តមណ្ឌលគីរី ដើម្បីដាំដុះសណ្ដែកផ្កាយតាមបែបធម្មជាតិ និងគ្មានសារធាតុគីមី។ ផលិតផលបច្ចុប្បន្នរបស់ លោក សុង សេង រួមមាន ប្រេងអូមេហ្គា គ្រាប់សណ្ដែកផ្កាយលីង តែសណ្ដែកម្សាយ និងម្សៅសណ្ដែកផ្សាយ ដែលត្រូវបានចែកចាយលក់ក្នុងស្រុកមាននៅទូទាំងរាជធានីភ្នំពេញ ខេត្តសៀមរាប និងខេត្តកំពង់ធំ តាមរយៈប្រព័ន្ធពាណិជ្ជកម្មអេឡិចត្រូនិក (e-commerce) ឱសថស្ថាន និងម៉ាតនានា ហើយសមាគមរបស់លោកក៏មានការលក់បោះដុំគ្រាប់សណ្ដែកផ្កាយចេញទៅកាន់ទីផ្សារអន្តរជាតិផងដែរ។ នាពេលអនាគត សមាគមសួស្តីកម្ពុជា មានគោលបំណងពង្រីកប្រែក្លាយសមាគមទៅជាជាសហគ្រាសដ៏ធំមួយ ដែលមានការសហការជាមួយដៃគូវិនិយោគអន្តរជាតិនានា ក្នុងការជំរុញកំណើនសេដ្ឋកិច្ចជាតិប្រកបដោយចីរភាព។
  ],
