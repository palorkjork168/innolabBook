// ------------------------------------------------------------
// LOCAL DATA COMPONENTS
// Self-contained so we do not depend on chart helper signatures.
// ------------------------------------------------------------

#let data-row(label, value, note: none, height: auto) = block(
  width: 100%,
  height: height,
  inset: (y: 3.5mm, x: 0mm),
  stroke: (bottom: 0.6pt + colors.line),
)[
  #grid(
    columns: (1fr, 34mm),
    gutter: 5mm,
    align: (left, right),

    [
      #block[
        #set par(leading: 6.2pt, justify: false)
        #text(
          font: fonts.main,
          size: 9.5pt,
          weight: 500,
          fill: colors.text,
        )[
          #label
        ]
      ]

      #if note != none {
        v(1.5mm)
        block[
          #set par(leading: 5.5pt, justify: false)
          #text(
            font: fonts.main,
            size: 7.5pt,
            fill: colors.gray,
          )[
            #note
          ]
        ]
      }
    ],

    [
      #text(
        font: fonts.display,
        size: 15pt,
        weight: 700,
        fill: colors.primary,
      )[
        #value
      ]
    ],
  )
]

#let data-label(body) = [
  #text(
    font: fonts.display,
    size: 7.5pt,
    weight: 600,
    fill: colors.primary,
  )[
    #body
  ]
]

#let comparison-box(title, before, after, height: auto) = block(
  width: 100%,
  height: height,
  fill: colors.sage,
  inset: 5mm,
  radius: 2mm,
)[
  #text(
    font: fonts.main,
    size: 10pt,
    weight: 700,
    fill: colors.text,
  )[
    #title
  ]

  #v(4mm)

  #grid(
    columns: (1fr, 1fr),
    gutter: 5mm,

    [
      #text(
        font: fonts.display,
        size: 7.5pt,
        weight: 600,
        fill: colors.gray,
      )[
        BEFORE
      ]

      #v(2mm)

      #before
    ],

    [
      #text(
        font: fonts.display,
        size: 7.5pt,
        weight: 600,
        fill: colors.primary,
      )[
        AFTER
      ]

      #v(2mm)

      #after
    ],
  )
]

